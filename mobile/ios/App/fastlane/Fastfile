default_platform(:ios)

# All account-specific values (certificate, provisioning profile, API key)
# arrive as base64-encoded GitHub Actions secrets and are decoded to files
# by the workflow before this lane runs - nothing here is specific to any
# one Apple account, so this file is safe to commit.
platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    setup_ci

    # Ask the system which keychain setup_ci actually made the default,
    # rather than assuming the bare name "fastlane_tmp_keychain" resolves
    # the same way in every subsequent command - avoids a keychain-path
    # mismatch between import_certificate and later security/xcodebuild
    # calls, which otherwise fails silently (the item "imports" successfully
    # into one keychain while the build searches a different one).
    keychain_path = sh("security default-keychain", log: false).strip.delete('"')
    UI.message("Resolved CI keychain path: #{keychain_path}")

    import_certificate(
      certificate_path: "certificate.p12",
      certificate_password: ENV["CERTIFICATE_PASSWORD"],
      keychain_path: keychain_path,
      keychain_password: "",
    )

    # macOS enforces ACLs on imported private keys - without granting the
    # codesign/security tools access to this keychain's partition list,
    # xcodebuild can "see" the certificate but silently can't actually use
    # its private key, which surfaces as a generic "no identity found" error
    # further down rather than a permissions error here.
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' \"#{keychain_path}\"")

    sh("security list-keychains")
    sh("security find-identity -v -p codesigning \"#{keychain_path}\" || true")

    install_provisioning_profile(path: "profile.mobileprovision")

    build_number = latest_testflight_build_number(
      api_key_path: "app_store_connect_api_key.json",
    ) + 1
    increment_build_number(build_number: build_number, xcodeproj: "App.xcodeproj")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["APP_IDENTIFIER"] => ENV["PROVISIONING_PROFILE_NAME"],
        },
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
        "PROVISIONING_PROFILE_SPECIFIER=\"#{ENV['PROVISIONING_PROFILE_NAME']}\"",
        "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
      ].join(" "),
    )

    upload_to_testflight(
      api_key_path: "app_store_connect_api_key.json",
      skip_waiting_for_build_processing: true,
    )
  end
end
